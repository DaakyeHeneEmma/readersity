# Expo client: use the Supabase publishable key (or legacy anon key), never a secret/service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_SUPABASE_LIBRARY_BUCKET=library-files
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Local Drive sync only. Keep both credentials out of the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
GDRIVE_SERVICE_ACCOUNT_FILE=./gdrive_key.json
GDRIVE_ROOT_FOLDER_ID=
SUPABASE_LIBRARY_BUCKET=library-files
